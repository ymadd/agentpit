{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentpit-dashboard",
  "version": "0.1.24",
  "identifier": "dev.agentpit.dashboard",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "agentpit dashboard",
        "width": 760,
        "height": 640,
        "minWidth": 520,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
