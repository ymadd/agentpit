Output assets/demo.gif

Set Shell "zsh"
Set FontSize 14
Set Width 1100
Set Height 640
Set TypingSpeed 45ms
Set Theme "Dracula"
Set PlaybackSpeed 1.0

Hide
Type "export PATH=$PWD/target/release:$PATH" Enter
Type "clear" Enter
Show

Type "agentpit --help"
Sleep 600ms
Enter
Sleep 3500ms

Type "clear" Enter
Sleep 400ms

Type "agentpit status"
Sleep 500ms
Enter
Sleep 4000ms

Type "clear" Enter
Sleep 300ms

Type "# route review through Antigravity (agy)"
Sleep 800ms
Enter
Type "agentpit config route review --backend antigravity"
Sleep 600ms
Enter
Sleep 2500ms

Type "agentpit status"
Sleep 400ms
Enter
Sleep 3500ms
