{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentpit",
  "mainBinaryName": "agentpit-dashboard",
  "version": "0.1.33",
  "identifier": "dev.agentpit.desktop",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "agentpit",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/agentpit-control-pit.png"],
    "category": "DeveloperTool",
    "shortDescription": "Desktop control plane for agentpit workflows and agent CLIs",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
